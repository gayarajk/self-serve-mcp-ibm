# deploy/ibm/prebuilt-image/.env.example
#
# Copy to .env and fill in real values:
#   cp deploy/ibm/prebuilt-image/.env.example deploy/ibm/prebuilt-image/.env
#
# Source before running deploy.sh:
#   set -a; source deploy/ibm/prebuilt-image/.env; set +a
#
# DO NOT commit .env — it is git-ignored.

# ── IBM Cloud target ─────────────────────────────────────────────────────────
IBM_CLOUD_REGION=ca-tor
IBM_RESOURCE_GROUP=Default

# ── Code Engine project ──────────────────────────────────────────────────────
CE_PROJECT=gsa-graj-ce

# ── Registry (GHCR public image — no ICR auth required) ─────────────────────
# Format: ghcr.io/<GITHUB_USER>/<IMAGE_NAME>:<TAG>
TOOLS_IMAGE=ghcr.io/<GITHUB_USER>/gsa-graj-tools:latest
VIZ_IMAGE=ghcr.io/<GITHUB_USER>/gsa-graj-viz:latest

# ── Code Engine app names ────────────────────────────────────────────────────
TOOLS_APP_NAME=gsa-graj-tools
VIZ_APP_NAME=gsa-graj-viz

# ── App sizing ───────────────────────────────────────────────────────────────
APP_PORT=8000
APP_CPU=0.25
APP_MEMORY=500M
APP_MIN_SCALE=1

# ── PostgreSQL credentials — stored as a CE secret ───────────────────────────
# The secret name must already exist in the CE project (created once).
# See README.md §Prerequisites.
CE_PG_SECRET_NAME=postgres-secret
