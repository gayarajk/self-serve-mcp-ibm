# ── LLM provider ──────────────────────────────────────────────────────────────
USAI_API_KEY=your-api-key-here
USAI_BASE_URL=https://your-llm-provider-base-url/v1

# Model for the agent (OpenAI-compatible model identifier)
AGENT_MODEL=openai/gpt-4o

# Model for LLM-as-judge (defaults to AGENT_MODEL if not set)
JUDGE_MODEL=openai/gpt-4o

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Option 1 — IBM Cloud Databases for PostgreSQL (Code Engine / production)
# Set DATABASE_URL to the full connection string provided by ICD.
# SSL is enabled automatically; sslmode=verify-full is the default.
#
# DATABASE_URL=postgresql://admin:PASSWORD@hostname.databases.appdomain.cloud:31234/ibmclouddb?sslmode=verify-full
#
# Optional: path to the ICD CA certificate (download from IBM Cloud console)
# PGSSLROOTCERT=/path/to/postgresql.crt

# Option 2 — Local development (individual env vars, no SSL by default)
PG_HOST=localhost
PG_PORT=5432
PG_DB=wxodb
PG_USER=wxouser
PG_PASS=wxopass
# Set PGSSL=true to force SSL even with individual env vars
# PGSSL=true

# ── Arize Phoenix ──────────────────────────────────────────────────────────────
# Local Phoenix (default — no API key needed)
PHOENIX_BASE_URL=http://localhost:6006

# Hosted Phoenix (uncomment and fill in)
# PHOENIX_BASE_URL=https://your-phoenix-instance.arize.com
# PHOENIX_API_KEY=your-phoenix-api-key
