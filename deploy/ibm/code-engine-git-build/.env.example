# GSA GRAJ — IBM Code Engine BUILD-FROM-GIT deployment configuration.
#
# Copy to .env and fill in IBMCLOUD_API_KEY, then:
#   set -a; source deploy/ibm/code-engine-git-build/.env; set +a
# before running deploy-build-from-git.sh.
#
# This file contains NO secrets — only non-sensitive deployment coordinates.
# Your IBM Cloud API key is NEVER stored here (see IBMCLOUD_API_KEY note below).
#
# What this kit does:
#   Code Engine clones GIT_REPO_URL, builds its Dockerfile SERVER-SIDE, pushes
#   the resulting image to your IBM Container Registry (ICR) namespace, then
#   deploys it. No local Docker or podman required.

# --- IBM Cloud target --------------------------------------------------------
IBMCLOUD_REGION=ca-tor
IBMCLOUD_RESOURCE_GROUP=Default

# --- Code Engine project -----------------------------------------------------
CE_PROJECT=gsa-graj-ce

# --- Port the container listens on -------------------------------------------
# server.py reads PORT from the environment to select HTTP vs stdio transport.
# Code Engine / Knative injects PORT at runtime — do NOT set it as a CE env var.
# This value is only used by this deploy script for --port; CE overrides it.
CE_PORT=8000

# --- Git source (public repo Code Engine will clone + build) -----------------
# Point at your GitHub fork or the upstream template.
GIT_REPO_URL=https://github.com/<YOUR_GITHUB_USER>/wxo-agentic-workflow
GIT_BRANCH=main

# --- IBM Container Registry --------------------------------------------------
# This account's ICR region is ca-tor → domain is ca.icr.io
ICR_REGION=ca-tor
ICR_DOMAIN=ca.icr.io
ICR_NAMESPACE=gsa-graj-wxo
IMAGE_TAG=latest

# Name of the Code Engine registry-access secret (a CE object name, not a
# credential). The deploy script creates / updates it from your API key.
CE_REGISTRY_SECRET=icr-push-secret

# --- Per-app overrides (set before running for each app) ---------------------
# Override these at run time or export them before sourcing this file:
#
#   # Deploy gsa_graj_tools:
#   export CE_APP_NAME=gsa-graj-tools
#   export GIT_CONTEXT_DIR=toolkits/gsa_graj_tools
#   export GIT_DOCKERFILE=toolkits/gsa_graj_tools/Dockerfile
#   bash deploy/ibm/code-engine-git-build/deploy-build-from-git.sh
#
#   # Deploy gsa_graj_viz:
#   export CE_APP_NAME=gsa-graj-viz
#   export GIT_CONTEXT_DIR=toolkits/gsa_graj_viz
#   export GIT_DOCKERFILE=toolkits/gsa_graj_viz/Dockerfile
#   bash deploy/ibm/code-engine-git-build/deploy-build-from-git.sh
#
# Defaults (used if the env vars are not overridden):
CE_APP_NAME=gsa-graj-tools
GIT_CONTEXT_DIR=toolkits/gsa_graj_tools
GIT_DOCKERFILE=toolkits/gsa_graj_tools/Dockerfile

# --- IBM Cloud API key (NOT stored in this file) -----------------------------
# The registry-access secret is created from an IBM Cloud IAM API key.
# Provide it at runtime — NEVER commit it:
#
#   export IBMCLOUD_API_KEY="$(ibmcloud iam api-key-create ce-icr-push \
#       -d 'Code Engine ICR push' --output json | jq -r .apikey)"
#
# If IBMCLOUD_API_KEY is unset the script prompts (hidden) and never writes
# it to disk. Rotate / delete when finished:
#   ibmcloud iam api-key-delete ce-icr-push

# --- PostgreSQL secret (injected into the CE app at runtime) -----------------
# The script references a Code Engine secret called 'postgres-secret' via
# --env-from-secret. Create it once per project:
#
#   ibmcloud ce project select --name gsa-graj-ce
#   ibmcloud ce secret create --name postgres-secret \
#     --from-literal DATABASE_URL="postgresql://user:pass@host:port/db?sslmode=require"
#
# Or add individual key-value pairs:
#   ibmcloud ce secret create --name postgres-secret \
#     --from-literal PG_HOST=... \
#     --from-literal PG_PORT=5432 \
#     --from-literal PG_DB=wxodb \
#     --from-literal PG_USER=wxouser \
#     --from-literal PG_PASS=...
